mid   = c(42.5, 47.5, 52.5, 57.5, 62.5, 67.5)
boys  = c(5, 10, 15, 30, 5, 5)
girls = c(15, 20, 30, 20, 5, 0)
h = 5

# ---- Boys ----
N_b = sum(boys)
mean_b = sum(boys * mid) / N_b
var_b = sum(boys * (mid - mean_b)^2) / N_b
sd_b = sqrt(var_b)
cv_b = (sd_b / mean_b) * 100     # Coefficient of Variation, for comparing two groups

mean_b; var_b; sd_b; cv_b

# ---- Girls ----
N_g = sum(girls)
mean_g = sum(girls * mid) / N_g
var_g = sum(girls * (mid - mean_g)^2) / N_g
sd_g = sqrt(var_g)
cv_g = (sd_g / mean_g) * 100

mean_g; var_g; sd_g; cv_g

# ---- Comparison ----
cat("Boys variance:", var_b, " | Girls variance:", var_g, "\n")
cat("Boys CV%:", cv_b, " | Girls CV%:", cv_g, "\n")