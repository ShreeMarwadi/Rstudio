# Create a data frame
data <- data.frame(
  Units_Sold = c(10, 20, 30, 40, 50, 60, 70, 80),
  Revenue = c(200, 400, 600, 800, 1000, 1200, 1400, 1600)
)
 
# Fit the linear model
model <- lm(Revenue ~ Units_Sold, data = data)
 
# Display the model summary
summary(model)
 
# Extract coefficients
coefficients <- coef(model)
intercept <- coefficients[1]   # Intercept 'a'
slope <- coefficients[2]       # Slope 'b'
 
# Display coefficients
print(paste("Intercept (a):", intercept))
print(paste("Slope (b):", slope))
