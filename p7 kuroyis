## Que 1: Kurtosis of heights dataset
data1 <- c(160, 165, 170, 175, 180, 185, 190, 195, 200, 205)
m2 <- mean((data1 - mean(data1))^2)
m4 <- mean((data1 - mean(data1))^4)
kurtosis1 <- m4 / (m2^2)
kurtosis1

