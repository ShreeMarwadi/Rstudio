## Que 6: Kurtosis of frequency distribution (units sold)
x6 <- c(10, 20, 30, 40, 50)
f6 <- c(5, 8, 7, 4, 3)
N6 <- sum(f6)
xbar6 <- sum(f6 * x6) / N6
m2 <- sum(f6 * (x6 - xbar6)^2) / N6
m4 <- sum(f6 * (x6 - xbar6)^4) / N6
kurtosis6 <- m4 / (m2^2)
kurtosis6