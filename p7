## Que 1: Skewness of ages dataset
data1 <- c(22, 25, 27, 24, 29, 30, 22, 26, 31, 24)
n1 <- length(data1)
m2 <- mean((data1 - mean(data1))^2)
m3 <- mean((data1 - mean(data1))^3)
skewness1 <- m3 / (m2^(3/2))
skewness1

