## Que 4: Skewness of frequency distribution (items purchased)
x4 <- c(1, 2, 3, 4, 5)
f4 <- c(10, 12, 8, 5, 3)
N4 <- sum(f4)
xbar4 <- sum(f4 * x4) / N4
m2 <- sum(f4 * (x4 - xbar4)^2) / N4
m3 <- sum(f4 * (x4 - xbar4)^3) / N4
skewness4 <- m3 / (m2^(3/2))
skewness4

